{
  "name": "Audit Navy",
  "dataColors": ["#1F3A5F", "#C0392B", "#3A7CA5", "#E59F3B", "#7F8C9A", "#81B29A", "#5B6C8F", "#D4A5A5"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F3A5F",
  "visualStyles": {
    "*": {
      "*": {
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#1F2933" } },
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold"
        }],
        "background": [{
          "show": true,
          "color": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        }],
        "border": [{
          "show": true,
          "color": { "solid": { "color": "#E3E7ED" } },
          "radius": 8
        }],
        "dropShadow": [{ "show": true }]
      }
    },
    "page": {
      "*": {
        "background": [{
          "color": { "solid": { "color": "#F3F5F8" } },
          "transparency": 0
        }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "color": { "solid": { "color": "#1F3A5F" } },
          "fontSize": 26
        }],
        "categoryLabels": [{
          "show": true,
          "color": { "solid": { "color": "#5B6775" } },
          "fontSize": 11
        }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [{ "show": true }],
        "valueAxis": [{ "show": false, "gridlineShow": false }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [{ "show": true }],
        "valueAxis": [{ "show": false, "gridlineShow": false }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#1F3A5F" } }
        }],
        "values": [{
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#F3F5F8" } }
        }]
      }
    }
  }
}
